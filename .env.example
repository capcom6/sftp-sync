# Environment Configuration Template for sftp-sync
# Copy this file to .env and fill in your actual values.
# This file documents every environment variable the application actually reads.
#
# The .env file is loaded from the current working directory at startup
# (via github.com/joho/godotenv). A missing file is ignored.
# Variables already present in the shell are NOT overridden.
#
# NOTE: credentials used by the destination URL (passwords, key passphrases)
# are NOT separate environment variables — they are passed inside the
# destination URL itself, either via --dest or via SFTP_SYNC_DEST below.
# Do not commit a real .env file: it is already listed in .gitignore.

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Debug Logging
# Purpose: Enables debug-level logging for the whole application; same effect
#          as passing the --debug flag on the command line.
# Format:  Boolean value accepted by Go's strconv.ParseBool
#          (1, t, T, true, TRUE, True).
#          0 or false disables debug logging; unset (default) disables it.
#          An unparseable value (e.g. "yes") makes the command fail at startup.
# Default: unset (disabled)
# Example: DEBUG=1
DEBUG=0

# =============================================================================
# DESTINATION
# =============================================================================

# Destination Server URL
# Purpose: Provides the destination FTP/SFTP server URL — same value as the
#          --dest flag. An explicit --dest on the command line takes
#          precedence over this variable.
# Format:  FTP or SFTP URL, including credentials and query parameters:
#            ftp://user:pass@host:21/path
#            sftp://user:pass@host:22/path?key=~/.ssh/id_ed25519&agent=true
# Default: unset — required unless --dest is passed on the command line.
#          An empty value counts as set and makes the command fail with
#          "destination server is required".
# Example: SFTP_SYNC_DEST=ftp://user:pass@hostname/path/to/remote/folder
#SFTP_SYNC_DEST=ftp://user:pass@hostname/path/to/remote/folder

# =============================================================================
# SSH AUTHENTICATION (SFTP destinations only)
# =============================================================================

# SSH Agent Socket
# Purpose: Read by sftp-sync when the destination URL enables the SSH agent
#          (?agent=true) to authenticate to an SFTP server. Provides the
#          signers used for public-key authentication.
# Format:  Absolute path to a Unix domain socket.
# Default: provided by ssh-agent / the system — do not set it yourself unless
#          you know you need to; leaving it unset disables agent auth.
# Example: SSH_AUTH_SOCK=/tmp/ssh-XXXXXX/agent.1234
#SSH_AUTH_SOCK=/tmp/ssh-XXXXXX/agent.1234
